@model List<Register>

    <table border="2">
    <tr> <th>ID</th><th>Öğrenci Bilgisi</th><th>Ders Bilgisi</th><th>İşlemler</th>


    </tr>

   
@foreach (var regg in Model)
{
    <tr border="2">
            <td> @regg.Id</td>
            <td> @($"{regg.Student.Name} {@regg.Student.SurName}")</td>
            <td> @regg.Lesson.Name </td>
   <td>
    <a href="Delete/@regg.Id" class="btn btn-warning">Sil</a>
                <a href="Update/@regg.Id" class="btn btn-danger">Güncelle</a>
            </td>
        </tr>

}
</table>

<a class="btn btn-primary" href="Register/Index">Yeni Ders Kaydı Ekle</a>